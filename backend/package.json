{
  "name": "nexalearn-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.mkdirSync('public', {recursive: true}))\"",
    "start": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --import tsx --test tests/validation.spec.ts tests/http.spec.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "create:admin": "node --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
