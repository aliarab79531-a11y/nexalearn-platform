{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm --prefix frontend run build:static",
  "outputDirectory": "frontend/dist/ai-learning-platform",
  "regions": ["dub1"],
  "rewrites": [
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
