{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm --prefix frontend run build:static",
  "outputDirectory": "frontend/dist/ai-learning-platform/browser",
  "regions": ["dub1"],
  "functions": {
    "api/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/((?!api/|api$).*)", "destination": "/index.html" }
  ]
}
