{
  "name": "nexalearn-ai",
  "version": "0.0.0",
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend start",
    "backend:dev": "npm --prefix backend run dev",
    "start:api": "npm --prefix backend start",
    "build": "npm --prefix frontend run build:static",
    "build:static": "npm --prefix frontend run build:static",
    "test": "npm --prefix frontend run test:ci",
    "test:watch": "npm --prefix frontend test",
    "test:api": "npm --prefix backend test",
    "seed:demo": "npm --prefix backend run seed",
    "create:admin": "npm --prefix backend run create:admin"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
