# ==============================================================================
# NexaLearn AI Platform - Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# Security & Authentication (minimum 32 characters)
AUTH_JWT_SECRET=d97a205c888f082d2739023c4b642fcc829a0877a7518e7ea585895053183d21

# MongoDB Atlas Connection
# Note: In MongoDB Atlas Network Access, ensure 0.0.0.0/0 is allowed for Vercel
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexalearn?retryWrites=true&w=majority
MONGO_DB_NAME=nexalearn

# Frontend URL (optional, defaults to allowing *.vercel.app and localhost)
FRONTEND_URL=https://your-project.vercel.app

# Local Development Only
PORT=4301
API_PORT=4301

