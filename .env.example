# Supabase PostgreSQL connection string. URL-encode special password characters (for example @ as %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Generate a private secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
API_PORT=4301
DATABASE_POOL_SIZE=5
# Optional: path to the Supabase root CA downloaded from Database > Settings > SSL Configuration.
DATABASE_SSL_ROOT_CERT=
